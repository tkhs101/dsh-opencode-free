{
  "name": "dsh-opencode-free",
  "version": "0.3.5",
  "packageManager": "pnpm@11.19.0",
  "description": "Free OpenCode Zen models in DeepSeek Harness through native HTTP requests. No OpenCode installation, login, API key, server, container, or LiteLLM is required.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkhs101/dsh-opencode-free.git"
  },
  "homepage": "https://github.com/tkhs101/dsh-opencode-free",
  "bugs": "https://github.com/tkhs101/dsh-opencode-free/issues",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "src/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-TW.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "pretest": "pnpm run build",
    "prepack": "pnpm run build",
    "prepublishOnly": "node scripts/guard-dirty-publish.mjs && pnpm run check",
    "test": "tsx --test tests/*.test.mjs",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm pack --pack-destination .artifacts && pnpm run verify-notes && pnpm run verify-vendored",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify-agent-note-tree": "tsx scripts/notes/verify-agent-note-tree.ts",
    "verify-agent-note-format": "tsx scripts/notes/verify-agent-note-format.ts",
    "verify-archived": "tsx scripts/notes/verify-archived-agent-notes.ts",
    "verify-notes": "pnpm run verify-agent-note-tree && pnpm run verify-agent-note-format && pnpm run verify-archived",
    "verify-vendored": "node scripts/verify-vendored.mjs",
    "check-anchors": "tsx scripts/notes/check-note-anchors.ts",
    "archive-agent-note": "tsx scripts/notes/archive-agent-note.ts",
    "init-board": "tsx scripts/notes/build-board.ts --init board.html \"dsh-opencode-free\"",
    "bundle-board": "tsx scripts/notes/build-board.ts --bundle .agents/notes board.html \"dsh-opencode-free\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "opencode",
    "zen",
    "free"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
